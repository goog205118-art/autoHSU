# Copy to .env. Run node server.mjs. No npm install required. Node >=22.
PORT=8787
# demo is opt-in: node server.mjs --demo. Real mode never falls back to mock data.
DEMO_MODE=false
# Required for real API mode on Vercel. Choose your own code, at least 12 chars.
APP_ACCESS_CODE=

# text: gemini | compatible
TEXT_PROVIDER=gemini
TEXT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
TEXT_API_KEY=
# Choose a currently available multimodal model from YOUR provider.
TEXT_MODEL=

# image: gemini | compatible | custom
IMAGE_PROVIDER=gemini
IMAGE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_API_KEY=
IMAGE_MODEL=

# compatible uses multipart /images/edits to preserve product references.
# "provider" passes the selected size through; "standard" maps portrait/landscape
# to 1024x1536 / 1536x1024 and leaves the square at 1024x1024.
IMAGE_SIZE_MODE=standard

# Custom JSON image adapter (optional). See docs/API.md for its contract.
IMAGE_SUBMIT_URL=
# Optional polling URL with {taskId}. Requests use GET with Bearer auth.
IMAGE_POLL_URL=
API_TIMEOUT_MS=180000
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=300000
